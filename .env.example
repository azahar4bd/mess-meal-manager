# ─────────────────────────────────────────────────────────────
# Mess Meal Manager — environment configuration
# copy this file to `.env.local` and fill in the values
# ─────────────────────────────────────────────────────────────

# PostgreSQL (primary database — single source of truth)
#   local / VPS : postgresql://messapp:messapp@127.0.0.1:5432/mess_manager
#   Neon (Vercel): postgresql://USER:PASS@ep-xxxx-POOLER.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL=postgresql://messapp:messapp@127.0.0.1:5432/mess_manager

# Driver selection — leave empty for auto-detect:
#   host contains "neon.tech"  → Neon serverless websocket driver (Vercel/Lambda)
#   anything else              → node-postgres TCP pool (local/VPS)
# Force one with: DB_DRIVER=neon  |  DB_DRIVER=pg
DB_DRIVER=
PG_POOL_MAX=10

# One-shot schema setup on platforms without a shell (Vercel + Neon).
# Set a long random value, deploy, call POST /api/migrations {"secret":"…"} ONCE,
# verify GET /api/setup/status, then DELETE this variable and redeploy.
#   generate: openssl rand -hex 24
MIGRATION_SECRET=

# Google Apps Script Web App (/exec) URL — the sync endpoint
GOOGLE_SCRIPT_WEB_APP_URL=

# Optional legacy webhook (kept for compatibility, same purpose as above)
GOOGLE_SHEETS_WEBHOOK=

# Fallback / default Google Sheet URL (per-office URL is stored in DB: offices.sheet_url)
GOOGLE_SHEET_URL=
NEXT_PUBLIC_GOOGLE_SHEET_URL=

# Secret used to sign/rotate session tokens (32+ random chars). Generate:
#   openssl rand -hex 32
SESSION_SECRET=change-me-in-production-please-use-a-long-random-string

# Comma separated list of extra trusted proxy hosts (optional)
# TRUST_PROXY=1

# Seed credentials for the platform admin (DEMO ONLY — change before production)
SEED_ADMIN_USER_ID=01700000000
SEED_ADMIN_PASSWORD=admin
SEED_ADMIN_NAME=Platform Admin

# Set to 1 to enable automatic Google Sheet sync after every write
AUTO_SYNC=0

# Set to 1 to allow the admin UI to reveal passwords (development/demo only)
SHOW_PASSWORDS_IN_ADMIN=0

# Node environment
NODE_ENV=development

# Optional: lets POST /api/dev/reset-rate-limits clear the in-memory limiter
# (used by the E2E suite). Empty = only a logged-in platform admin may call it.
RATE_LIMIT_RESET_SECRET=
